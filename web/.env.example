# .env.local として保存する(ローカル開発用。本番は g3plus-ops/trip-note/.env)
# iOS アプリからの /api/sync を保護する共有シークレット。`openssl rand -hex 32` などで生成する
API_SHARED_SECRET=dev-secret
# SQLite の保存先(省略時: ./data/trip-note.db)
# TRIPNOTE_DB_PATH=./data/trip-note.db
# AI 提案・検索補助のプロバイダキー(使うモデルの分だけ設定する。/settings でモデル選択)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
